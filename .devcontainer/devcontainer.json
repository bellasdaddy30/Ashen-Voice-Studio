{
  "name": "Ashen Voice Fixed WASM Test",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Ashen Voice · Fixed VoxShot WASM",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup_voxshot.sh",
  "postStartCommand": "cd .codespace-test && nohup npm run dev -- --host 0.0.0.0 --port 8080 > /tmp/ashen-fixed-wasm.log 2>&1 &"
}
