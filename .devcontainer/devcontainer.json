{
  "name": "Ashen Voice Fixed WASM Test",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [8091],
  "portsAttributes": {
    "8091": {
      "label": "Ashen Voice · Static Fixed Chatterbox · PORT 8091",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup_voxshot.sh",
  "postStartCommand": "nohup node .devcontainer/static_server.mjs > /tmp/ashen-fixed-wasm-8091.log 2>&1 &"
}
