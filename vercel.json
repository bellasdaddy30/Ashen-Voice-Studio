{
  "rewrites": [
    {
      "source": "/ort/:path*",
      "destination": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.26.0-dev.20260416-b7804b056c/dist/:path*"
    }
  ],
  "headers": [
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/kokoro-worker.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/diagnostics.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/book-data/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/ort/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ]
}
