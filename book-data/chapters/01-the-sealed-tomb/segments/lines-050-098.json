[{"id":"9f0c45b2-c7f4-47c8-a6f1-3927e10ac53b","text":"The mortar's been fired.","speaker":"Enhedu","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"25916fde-1f97-494c-9cba-af2bec88f98f","text":"Not fired.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"e5086082-5646-4bd9-a41a-70b79b49a68d","text":"Zik shook his head.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"67a5010e-4edc-4b22-b308-ebf74bc93d94","text":"Changed.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"f39320ca-8a8f-473d-b59f-8ce256015dc7","text":"He pointed to the black sheen running through the joint.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"2bee83c1-35b6-447e-a7e9-5eb5c53533da","text":"Clay melts if you get it hot enough. Not campfire hot. Kiln hot. Hot enough that whoever built this either knew something we've forgotten…","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"3fc30915-358f-442b-9752-780432f9bed4","text":"His finger traced the dark glass.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"3c801141-5e14-4e19-9ac8-ca658feca360","text":"…or they were trying to seal something badly enough that they invented a way.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"78662723-d28c-4f8c-87ed-22397cd950bd","text":"Kurash looked from the wall to the ridge disappearing beneath the sand.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"4ab5afbd-a9ae-452b-a1c2-01235b991174","text":"So this isn't a temple.","speaker":"Kurash","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"b7ab410b-ce6b-47bc-8550-aad3f7c41175","text":"No.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"635975ba-92fb-4f4f-9550-7c3b8132a31d","text":"A palace?","speaker":"Kurash","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"7b6928ab-30b7-4fba-8341-d9d1bf4aa0c6","text":"No.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"e3279344-d794-4637-9199-982ce7f8d251","text":"Then what is it?","speaker":"Kurash","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"ffc17fac-0554-4254-aace-d4a550555caa","text":"Zik smiled faintly.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"4ac46f66-f202-4306-8fe1-7591f34c0892","text":"If I already knew, we'd be digging somewhere else.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","note":"Keep the humor dry; do not overplay it.","generated":false},{"id":"f9688b43-2392-4ad0-bfb1-cf36753be97d","text":"Balag grunted.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"cd58c3c1-6f92-491f-b5c7-f6fcd30dcee9","text":"That's the first honest thing you've said today.","speaker":"Balag","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","note":"Keep the humor dry; do not overplay it.","generated":false},{"id":"fb794f72-238c-40da-85f6-ac84b1418303","text":"I've been honest all day.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","note":"Keep the humor dry; do not overplay it.","generated":false},{"id":"0190f18b-21f8-47bd-9d8c-8b271755d24b","text":"You've been specific. That's different.","speaker":"Balag","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","note":"Keep the humor dry; do not overplay it.","generated":false},{"id":"004568d6-3878-49a1-9ca7-f2c10d66631a","text":"Enhedu laughed.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"53a904cf-4b4a-41c3-8779-e6648fe30823","text":"I'll remember that.","speaker":"Enhedu","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","note":"Keep the humor dry; do not overplay it.","generated":false},{"id":"c1176856-e698-4171-b1e9-8d9d21e22911","text":"She leaned close to the exposed masonry, eyes narrowing.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"79c1ce0f-50b3-4bf1-8f1f-14f531e925e8","text":"These upper bricks don't match.","speaker":"Enhedu","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"f8cb2ba1-3e71-4dd4-8e80-6f3088d9f6f1","text":"They're replacements,","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"b6044d64-8abd-4465-bb54-aed1e416b612","text":"Zik said.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"9104c426-7479-456b-995a-81448fcbee19","text":"You can tell that from this?","speaker":"Enhedu","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"d84552a1-de25-42db-b924-ea8dd2868ca1","text":"I can tell from that.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"b530bd0a-9bb9-42ce-b2f7-0f122b4b9aec","text":"He pointed farther down the wall where the courses disappeared beneath packed sand.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"9d615440-356b-40ae-9dd2-839e663806d7","text":"The lower bricks settled decades before the upper ones were laid.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"0633fe1d-608a-49f9-912a-33eda1605727","text":"Kurash stared.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"e3fc87e4-8af2-4523-aa47-0e921955a886","text":"They all look the same.","speaker":"Kurash","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"c38a94c2-e10d-4971-989c-21fbe3c04539","text":"They're supposed to.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"062c9c1e-0d32-4234-8f34-1035626aac93","text":"Zik brushed away another thin layer of dust.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"1233cf99-baa3-409e-a2ef-36a20f64b26b","text":"The mason who repaired it copied the original dimensions.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"cf2c30f1-bc13-45bc-bdf2-34e0bf8ff89e","text":"So he fooled everyone.","speaker":"Kurash","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"034b9c49-d0d6-4862-a828-dee1d0702b3c","text":"He fooled almost everyone.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"eb691f3f-7d64-4faf-acd1-f056f230d626","text":"Enhedu looked sideways at him. The sideways look carried more amusement than surprise.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"78c9f09b-3846-417d-be08-367c0a86d970","text":"And you noticed because…","speaker":"Enhedu","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"7aaf0f00-b8a6-4551-882d-c8f73a4c8cc8","text":"The mortar shrank differently.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"4400cdb4-d080-4939-866e-fc48939860a8","text":"Kurash groaned.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"d6efb825-605e-4509-8487-5759ea83e871","text":"That's impossible.","speaker":"Kurash","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"f57004a4-e351-4e1e-84af-6c808838b5f6","text":"It isn't impossible.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"40881ab6-bf9b-4ce9-b3a0-7d4609df5b3c","text":"It's unfair.","speaker":"Kurash","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"1a543913-1f48-432c-bc0e-00c3c3594264","text":"Balag barked a laugh. The laugh struck the stone and came back larger.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"82e3505b-5878-48e6-916b-022050d62292","text":"I've been saying that for years.","speaker":"Balag","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","note":"Keep the humor dry; do not overplay it.","generated":false},{"id":"c7422ded-bcd0-4c02-b915-7c7b19985115","text":"Zik tucked the knife back into his belt.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false},{"id":"ba1c1ddd-fd59-4ab1-ae0a-ba178ae33f13","text":"My father used to say every wall lies.","speaker":"Zik","type":"dialogue","confidence":1,"pause":0.28,"delivery":"neutral","generated":false},{"id":"70e319aa-a383-409c-88b2-e6c3e453c02f","text":"Kurash frowned.","speaker":"Narrator","type":"narration","confidence":1,"pause":0.16,"delivery":"neutral","note":"Short attribution/action beat; keep tight to surrounding dialogue.","generated":false}]